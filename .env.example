# Kurum kimliği (beyaz etiket)
GA_ORG_NAME=Kurum Adı
# Ana renk (butonlar, gönder, asistan simgesi). Boşsa vurgu rengi kullanılır.
GA_ORG_PRIMARY=
# Vurgu rengi (aktif menü çizgisi, numaralar, küçük nokta detayları)
GA_ORG_ACCENT=#1F4FD1
# Logo: dosyayı frontend/public/brand/ içine koyun (bu klasör git'e gönderilmez).
# Örn. frontend/public/brand/logo.png  ->  GA_ORG_LOGO_URL=/brand/logo.png
GA_ORG_LOGO_URL=

# Veritabanı — PostgreSQL için: postgresql+psycopg://kullanici:sifre@sunucu:5432/gorev
# (Docker imajında varsayılan: sqlite:////data/gorev_asistani.db)
# GA_DATABASE_URL=sqlite:///./gorev_asistani.db

# LLM katmanı — mimari netleşene kadar mock
GA_LLM_PROVIDER=mock
GA_LLM_MODEL_LABEL=Yerel model (mock)

# Sprint kapasitesi (kişi başı iş günü)
GA_SPRINT_CAPACITY_DAYS=10

# Demo verisi (kurgusal ekip ve görevler)
GA_SEED_DEMO_DATA=true
